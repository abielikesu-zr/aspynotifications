# Type: EventsSdkParams
events_sdk:

  # Type: aspyadapters.adapters.http_client_config.HttpClientConfig | None
  http_client:

    # Maximum time in seconds to wait for an HTTP request to complete.

    # Type: float

    timeout: "{{  g_app_es_http_client_timeout | default(5.0) | float  }}"

    # Maximum number of times a failed HTTP request is retried.

    # Type: int

    max_retries: "{{  g_app_es_http_client_max_retries | default(1) | int  }}"

    # Initial backoff delay in seconds used before retrying a failed request.

    # Type: float

    backoff_base: "{{  g_app_es_http_client_backoff_base | default(0.15) | float  }}"

    # Maximum backoff delay in seconds between retry attempts.

    # Type: float

    backoff_max: "{{  g_app_es_http_client_backoff_max | default(1.0) | float  }}"

    # Whether TLS certificates are verified for HTTPS requests.

    # Type: bool

    verify: "{{  (g_app_es_http_client_verify | default(True)) is sameas true  }}"

  # Type: EventClientConfig
  events_client:

    # Type: aspyevents_sdk.entities.config.RestClientAdapterConfig | aspynats.config.nats_client_config.NatsClientAdapterConfig
    # Switch Variable: g_app_es_events_client_adapter_type
    adapter:

      {% if  g_app_es_events_client_adapter_type | default('REST') == 'REST' %}

        type: 'REST'

        # Type: RestClientConfig
        config:

          # Type: HttpUrl

          base_url: "{{  g_app_es_events_client_rest_base_url | default(None)   }}"

      {% elif  g_app_es_events_client_adapter_type == 'NATS' %}

        type: 'NATS'

        # Type: NatsClientConfig
        config:

          # Name of the JetStream stream used to store CloudEvents.

          # Type: NatsConnectionConfig
          connection:

            # URL of the NATS server to connect to.

            # Type: str

            nats_url: "{{  g_app_es_events_client_nats_connection_nats_url | default('nats://127.0.0.1:4222')   }}"

          # Subject pattern used by the stream to capture CloudEvents.

          # Type: NatsStreamConfig
          stream:

            # Name of the JetStream stream used to store CloudEvents.

            # Type: str

            name: "{{  g_app_es_events_client_nats_stream_name | default('EVENTS')   }}"

            # Subject pattern used by the stream to capture CloudEvents.

            # Type: str

            subject: "{{  g_app_es_events_client_nats_stream_subject | default('events.>')   }}"

      {% endif %}