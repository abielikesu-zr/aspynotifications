# Type: NotificationsSdkParams
notifications_sdk:

  # Type: Optional[HttpClientConfig]
  http_client:

    # Maximum time in seconds to wait for an HTTP request to complete.

    # Type: float

    timeout: "{{  g_app_ns_http_client_timeout | default(5.0) | float  }}"

    # Maximum number of times a failed HTTP request is retried.

    # Type: int

    max_retries: "{{  g_app_ns_http_client_max_retries | default(1) | int  }}"

    # Initial backoff delay in seconds used before retrying a failed request.

    # Type: float

    backoff_base: "{{  g_app_ns_http_client_backoff_base | default(0.15) | float  }}"

    # Maximum backoff delay in seconds between retry attempts.

    # Type: float

    backoff_max: "{{  g_app_ns_http_client_backoff_max | default(1.0) | float  }}"

    # Whether TLS certificates are verified for HTTPS requests.

    # Type: bool

    verify: "{{  (g_app_ns_http_client_verify | default(True)) is sameas true  }}"

  # Type: NotificationClientConfig
  notification_client:

    # Type: aspynotifications_sdk.entities.config.RestClientAdapterConfig
    adapter:

      # Type: Literal['REST']

      type: "{{  g_app_ns_notification_client_adapter_type | default('REST')   }}"

      # Type: RestClientConfig
      config:

        # Type: HttpUrl

        base_url: "{{  g_app_ns_notification_client_adapter_config_base_url | default(None)   }}"
