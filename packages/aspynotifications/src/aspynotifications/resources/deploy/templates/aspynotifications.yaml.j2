      config:

        # Directory where JSON files will be stored

        # Type: str

        data_dir: "{{  g_app_a_template_store_adapter_config_data_dir | default(None)   }}"

  # Type: TemplateServiceConfig
  template_service:

    # Type: Literal['yes']

    keep: 'yes'

