# Type: AspynotificationsAppParams
aspynotifications:

  # Type: StorageAdapterConfig
  policy_store:

    # Configuration for the storage adapter

    # Type: aspyadapters.config.local_fs_config.LocalFSAdapterConfig | aspyadapters.config.mongo_db_config.MongoDBAdapterConfig
    adapter:

      # Type of storage adapter

      # Type: Literal['LOCALFS']

      type: "{{  g_app_a_policy_store_adapter_type | default('LOCALFS')   }}"

      # LocalFS-specific configuration

      # Type: LocalFSConfig
      config:

        # Directory where JSON files will be stored

        # Type: str

        data_dir: "{{  g_app_a_policy_store_adapter_config_data_dir | default(None)   }}"

  # Type: NotificationPolicyServiceConfig
  policy_service:

    # Type: Literal['keep']

    keep: "{{  g_app_a_policy_service_keep | default('keep')   }}"

  # Type: StorageAdapterConfig
  destinations_store:

    # Configuration for the storage adapter

    # Type: aspyadapters.config.local_fs_config.LocalFSAdapterConfig | aspyadapters.config.mongo_db_config.MongoDBAdapterConfig
