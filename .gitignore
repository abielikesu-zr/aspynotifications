############################################################
# Canonical Python + aspy .gitignore
############################################################

# ---------- Python bytecode / caches ----------
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# ---------- Virtual environments ----------
.venv/
.venv*/
venv/
venv*/
.venv-build/
venv-build/
env/
ENV/
.env
.env.*

# ---------- Packaging / distribution ----------
.Python
build/
develop-eggs/
dist/
DIST/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
*.egg
*.egg-info/
.installed.cfg
*.manifest
*.spec

# ---------- Test / coverage / type checkers ----------
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
nosetests.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.cache/

# ---------- Logs & temporary files ----------
*.log
*.bak
*.back
*~
*.swp
*.swo
.DS_Store
**/.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ---------- Runtime / local state ----------
/var/
/localstate/
/localstore/
/cache/
/workdir/
/data/
/test-data/
/out/
/nats/
/secrets/
/corpus/

# ---------- aspy-specific ----------
.aspyapps/
.aspyapps
.aspy_cache/
.make-env
*.bin

# ---------- Symlinks created by aspyinit ----------
.bashrc
.zshrc
build.sh
publish.sh
Makefile
.gitignore.save

# ---------- Editor / IDE ----------
.idea/
.vscode/settings.json
.vscode/settings.machine.json

# ---------- Misc build artifacts ----------
packages/*/build/
*.so
*.class

# ---------- Requirements / lock files (generated or local) ----------
**/pyproject.toml
**/pyproject.prod.toml
**/requirements*.txt
**/requirements*.in

target/
tests/karate/